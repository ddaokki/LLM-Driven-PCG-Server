PORT=8000
REDIS_URL=redis://127.0.0.1:6379

# LLM 연동 (vLLM OpenAI 호환 API). 비워두면 규칙 기반 해석기로 동작.
# LLM_MODE: auto(기본, URL 있으면 vllm 시도 후 실패 시 rule) | vllm | rule
LLM_MODE=auto
LLM_API_URL=
# LLM_MODEL은 vLLM이 서빙하는 모델 id와 같아야 함(GET {LLM_API_URL}/models). 저사양 서버면 Qwen/Qwen3-8B-AWQ
LLM_MODEL=Qwen/Qwen3-8B
LLM_TIMEOUT_MS=8000
